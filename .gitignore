node_modules/
dist/
.DS_Store
*.log

# Ingested media and the local database never belong in the repo.
media/
data/
.superpowers/

# Downloaded media. Never committed — served from MEDIA_ROOT (an external
# drive in this deployment; see CLAUDE.md §1 and §9).
media/

# Secrets for local services (API keys). Never committed — see scripts/dev.sh,
# which sources this file if it exists.
.env.local

# Python environments for the two sidecars. `.venv-nllb` carries its own
# .gitignore, so git already skipped it — by accident rather than by anything
# this repository says. Named here so a differently-built environment is
# skipped too.
.venv*/
